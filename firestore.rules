rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // قاعدة بيانات المنظومة الحية والمزامنة بين كافة الأجهزة
    match /institution_database/{docId} {
      allow read: if true;
      allow write: if request.resource.data != null &&
        request.resource.data.keys().hasAll(['users']);
    }

    // سجل الكادر المعتمد وبيانات الدخول
    match /authorized_staff/{email} {
      allow read: if true;
      allow write: if request.resource.data != null &&
        request.resource.data.role in ['owner', 'developer', 'leader', 'supervisor', 'teacher'];
    }

    // وثائق صلاحيات وصول الكادر
    match /staff_access/{uid} {
      allow read: if true;
      allow write: if request.resource.data != null &&
        request.resource.data.role in ['owner', 'developer', 'leader', 'supervisor', 'teacher'];
    }

    // حظر الرموز والمسارات القديمة الملغاة
    match /staff_pins/{pinId} {
      allow read, write: if false;
    }

    // منع أي مسارات غير مصرح بها افتراضياً
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
