rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // قاعدة بيانات المنصة المركزية والمزامنة السحابية
    match /institution_database/{docId} {
      allow read, write: if true;
    }

    // الرموز السرية للمعلمات والمشرفات
    match /staff_pins/{pinId} {
      allow read, write: if true;
    }

    match /ghaym_institution/{docId} {
      allow read, write: if true;
    }

    // التحقق من أن المستخدم مسجل دخول
    function isAuthenticated() {
      return request.auth != null;
    }

    // جلب بيانات الحساب للتأكد من رتبته
    function getStaffData() {
      return get(/databases/$(database)/documents/staff/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        getStaffData().role == 'admin'
      );
    }

    function isTeacher() {
      return isAuthenticated() && (
        request.auth.token.role in ['admin', 'teacher'] ||
        getStaffData().role in ['admin', 'teacher']
      );
    }

    // الحلقات والمسارات
    match /tracks/{trackId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    match /circles/{circleId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // بيانات الطلاب
    match /students/{studentId} {
      allow read: if isAuthenticated();
      allow create, update: if isTeacher();
      allow delete: if isAdmin();
    }

    // الحفظ اليومي، الحضور والغياب، والاختبارات
    match /dailyMemorization/{docId} {
      allow read: if isAuthenticated();
      allow create, update: if isTeacher();
      allow delete: if isAdmin();
    }

    match /attendance/{docId} {
      allow read: if isAuthenticated();
      allow create, update: if isTeacher();
      allow delete: if isAdmin();
    }

    match /exams/{docId} {
      allow read: if isAuthenticated();
      allow create, update: if isTeacher();
      allow delete: if isAdmin();
    }

    // حسابات الكادر والإعدادات العامة (للإدارة فقط)
    match /staff/{staffId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
