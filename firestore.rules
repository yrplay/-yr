rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // قاعدة بيانات المقرأة والمزامنة السحابية الحية لكافة أقسام المنظومة
    match /institution_database/{docId} {
      allow read, write: if true;
    }

    // سجل الكادر المعتمد وبيانات الدخول
    match /authorized_staff/{email} {
      allow read, write: if true;
    }

    // وثائق صلاحيات وصول الكادر
    match /staff_access/{uid} {
      allow read, write: if true;
    }

    // حظر الرموز القديمة الملغاة
    match /staff_pins/{pinId} {
      allow read, write: if false;
    }

    // منع أي مسارات غير مصرح بها افتراضياً
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
